# Light+. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#008000"
color-link comment.bright "#008000"
color-link constant "#0000ff"
color-link constant.bool "#0000ff"
color-link constant.number "#098658"
color-link constant.string "#a31515"
color-link constant.string.char "#0000ff"
color-link constant.string.url "#a31515"
color-link constant.specialChar "#ee0000"
color-link identifier "#795e26"
color-link identifier.class "#267f99"
color-link identifier.var "#001080"
color-link identifier.macro "#0000ff"
color-link statement "#af00db"
color-link special "#af00db"
color-link preproc "#af00db"
color-link preproc.shebang "#008000"
color-link type "#267f99"
color-link type.keyword "#0000ff"
color-link symbol.operator "#000000"
color-link symbol.tag "#800000"
color-link symbol.tag.extended "#e50000"
color-link error "#cd3131"
color-link todo "bold #008000"
color-link underlined "underline #006ab1"
color-link selection "#000000,#add6ff"
color-link cursor-line ",#eeeeee"
color-link line-number "#237893"
color-link current-line-number "#0b216f"
color-link indent-char "#d3d3d3"
color-link match-brace "#000000,#b9b9b9"
color-link hlsearch "#000000,#f8c9aa"
color-link tabbar "#616161,#f3f3f3"
color-link tabbar.active "#333333,#ffffff"
color-link statusline "#616161,#f3f3f3"
color-link statusline.inactive "#616161,#f3f3f3"
color-link statusline.suggestions "#616161,#f3f3f3"
color-link divider "#d3d3d3"
color-link scrollbar "#c1c1c1"
color-link color-column ",#f2f2f2"
color-link diff-added "#48985d"
color-link diff-modified "#2090d3"
color-link diff-deleted "#e51400"
color-link gutter-error "#e51400"
color-link gutter-warning "#bf8803"
color-link gutter-info "#0063d3"
color-link error-message "#e51400"
color-link message "#000000"
color-link trailingws ",#f5a199"
color-link tab-error ",#f5a199"
