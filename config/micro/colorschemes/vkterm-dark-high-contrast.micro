# Dark High Contrast. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#7ca668"
color-link comment.bright "#7ca668"
color-link constant "#569cd6"
color-link constant.bool "#569cd6"
color-link constant.number "#b5cea8"
color-link constant.string "#ce9178"
color-link constant.string.char "#569cd6"
color-link constant.string.url "#ce9178"
color-link constant.specialChar "#569cd6"
color-link identifier "#dcdcaa"
color-link identifier.class "#4ec9b0"
color-link identifier.var "#9cdcfe"
color-link identifier.macro "#dcdcaa"
color-link statement "#c586c0"
color-link special "#c586c0"
color-link preproc "#c586c0"
color-link preproc.shebang "#7ca668"
color-link type "#4ec9b0"
color-link type.keyword "#569cd6"
color-link symbol.operator "#d4d4d4"
color-link symbol.tag "#569cd6"
color-link symbol.tag.extended "#9cdcfe"
color-link error "#f44747"
color-link todo "bold #7ca668"
color-link underlined "underline #21a6ff"
color-link selection "#000000,#ffffff"
color-link cursor-line "default"
color-link line-number "#ffffff"
color-link current-line-number "#f38518"
color-link indent-char "#ffffff"
color-link match-brace "#000000,#6fc3df"
color-link hlsearch "#000000,#ffffff"
color-link tabbar "#ffffff,#000000"
color-link tabbar.active "#ffffff,#000000"
color-link statusline "#ffffff,#000000"
color-link statusline.inactive "#ffffff,#000000"
color-link statusline.suggestions "#ffffff,#0c141f"
color-link divider "#6fc3df"
color-link scrollbar "#437586"
color-link color-column ",#4c4c4c"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f48771"
color-link gutter-error "#f48771"
color-link gutter-warning "#ffd370"
color-link gutter-info "#59a4f9"
color-link error-message "#f48771"
color-link message "#ffffff"
color-link trailingws ",#62362d"
color-link tab-error ",#62362d"
