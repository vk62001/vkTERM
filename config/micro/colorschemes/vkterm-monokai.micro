# Monokai. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#88846f"
color-link comment.bright "#88846f"
color-link constant "#ae81ff"
color-link constant.bool "#ae81ff"
color-link constant.number "#ae81ff"
color-link constant.string "#e6db74"
color-link constant.string.char "#ae81ff"
color-link constant.string.url "#e6db74"
color-link constant.specialChar "#ae81ff"
color-link identifier "#a6e22e"
color-link identifier.class "underline #a6e22e"
color-link identifier.var "#f8f8f2"
color-link identifier.macro "#a6e22e"
color-link statement "#f92672"
color-link special "#f92672"
color-link preproc "#f92672"
color-link preproc.shebang "#88846f"
color-link type "italic #66d9ef"
color-link type.keyword "italic #66d9ef"
color-link symbol.operator "#f92672"
color-link symbol.tag "#f92672"
color-link symbol.tag.extended "#a6e22e"
color-link error "#f44747"
color-link todo "bold #88846f"
color-link underlined "underline #3794ff"
color-link selection "#f8f8f2,#575a5a"
color-link cursor-line ",#3e3d32"
color-link line-number "#90908a"
color-link current-line-number "#c2c2bf"
color-link indent-char "#464741"
color-link match-brace "#f8f8f2,#888888"
color-link hlsearch "#f8f8f2,#683917"
color-link tabbar "#ccccc7,#1e1f1c"
color-link tabbar.active "#ffffff,#272822"
color-link statusline "#ccccc7,#1e1f1c"
color-link statusline.inactive "#ccccc7,#1e1f1c"
color-link statusline.suggestions "#cccccc,#1e1f1c"
color-link divider "#414339"
color-link scrollbar "#484845"
color-link color-column ",#363733"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#f8f8f2"
color-link trailingws ",#783633"
color-link tab-error ",#783633"
