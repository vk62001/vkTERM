# Catppuccin Mocha. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #9399b2"
color-link comment.bright "italic #9399b2"
color-link constant "#f38ba8"
color-link constant.bool "#fab387"
color-link constant.number "#fab387"
color-link constant.string "#a6e3a1"
color-link constant.string.char "#a6e3a1"
color-link constant.string.url "#89b4fa"
color-link constant.specialChar "#f5c2e7"
color-link identifier "italic #89b4fa"
color-link identifier.class "italic #f9e2af"
color-link identifier.macro "italic #89b4fa"
color-link statement "#cba6f7"
color-link special "#cba6f7"
color-link preproc "#f9e2af"
color-link preproc.shebang "italic #9399b2"
color-link type "italic #f9e2af"
color-link type.keyword "#cba6f7"
color-link symbol "#9399b2"
color-link symbol.operator "#94e2d5"
color-link symbol.brackets "#9399b2"
color-link symbol.tag "#89b4fa"
color-link symbol.tag.extended "#f9e2af"
color-link underlined "underline #89b4fa"
color-link todo "bold #9399b2"
color-link error "underline #f38ba8"
color-link selection "#cdd6f4,#3b3d4f"
color-link cursor-line ",#2a2b3c"
color-link line-number "#7f849c"
color-link current-line-number "#cba6f7"
color-link indent-char "#45475a"
color-link match-brace "#1e1e2e,#9399b2"
color-link hlsearch "#cdd6f4,#3e5767"
color-link tabbar "#6c7086,#11111b"
color-link tabbar.active "#cba6f7,#1e1e2e"
color-link statusline "#6c7086,#11111b"
color-link statusline.inactive "#6c7086,#11111b"
color-link statusline.suggestions "#cdd6f4,#181825"
color-link divider "#585b70"
color-link scrollbar "#3b3d4f"
color-link color-column ",#2f3042"
color-link diff-added "#a6e3a1"
color-link diff-modified "#f9e2af"
color-link diff-deleted "#f38ba8"
color-link gutter-error "#f38ba8"
color-link gutter-warning "#fab387"
color-link gutter-info "#89b4fa"
color-link error-message "#f38ba8"
color-link message "#cdd6f4"
color-link trailingws ",#734a5f"
color-link tab-error ",#734a5f"
