# Solarized Dark. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #586e75"
color-link comment.bright "italic #586e75"
color-link constant "#b58900"
color-link constant.bool "#b58900"
color-link constant.number "#d33682"
color-link constant.string "#2aa198"
color-link constant.string.char "#cb4b16"
color-link constant.string.url "#2aa198"
color-link constant.specialChar "#cb4b16"
color-link identifier "#268bd2"
color-link identifier.class "#cb4b16"
color-link identifier.var "#268bd2"
color-link identifier.macro "#268bd2"
color-link statement "#859900"
color-link special "#859900"
color-link preproc "#859900"
color-link preproc.shebang "italic #586e75"
color-link type "#859900"
color-link type.keyword "bold #93a1a1"
color-link symbol.operator "#859900"
color-link symbol.tag "#268bd2"
color-link symbol.tag.extended "#93a1a1"
color-link error "#dc322f"
color-link todo "bold #586e75"
color-link underlined "underline #3794ff"
color-link selection "#839496,#274642"
color-link cursor-line ",#073642"
color-link line-number "#858585"
color-link current-line-number "#949494"
color-link indent-char "#4a666c"
color-link match-brace "#002b36,#888888"
color-link hlsearch "#839496,#4e3b24"
color-link tabbar "#93a1a1,#004052"
color-link tabbar.active "#d6dbdb,#002b37"
color-link statusline "#93a1a1,#004052"
color-link statusline.inactive "#93a1a1,#004052"
color-link statusline.suggestions "#cccccc,#00212b"
color-link divider "#274a53"
color-link scrollbar "#304a51"
color-link color-column ",#1b3941"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#839496"
color-link trailingws ",#60383f"
color-link tab-error ",#60383f"
