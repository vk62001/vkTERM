# Abyss. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#384887"
color-link comment.bright "#384887"
color-link constant "#f280d0"
color-link constant.bool "#f280d0"
color-link constant.number "#f280d0"
color-link constant.string "#22aa44"
color-link constant.string.char "#f280d0"
color-link constant.string.url "#22aa44"
color-link constant.specialChar "#f280d0"
color-link identifier "#ddbb88"
color-link identifier.class "underline #ffeebb"
color-link identifier.macro "#ddbb88"
color-link statement "#225588"
color-link special "#225588"
color-link preproc "#225588"
color-link preproc.shebang "#384887"
color-link type "italic #9966b8"
color-link type.keyword "italic #9966b8"
color-link symbol.operator "#225588"
color-link symbol.tag "#225588"
color-link symbol.tag.extended "#ddbb88"
color-link error "#a22d44"
color-link todo "bold #384887"
color-link underlined "underline #3794ff"
color-link selection "#6688cc,#770811"
color-link cursor-line ",#082050"
color-link line-number "#406385"
color-link current-line-number "#80a2c2"
color-link indent-char "#002952"
color-link match-brace "#000c18,#888888"
color-link hlsearch "#000c18,#3f4851"
color-link tabbar "#888c96,#1c1c2a"
color-link tabbar.active "#ffffff,#000c18"
color-link statusline "#8e8e94,#1c1c2a"
color-link statusline.inactive "#8e8e94,#1c1c2a"
color-link statusline.suggestions "#cccccc,#262641"
color-link divider "#2b2b4a"
color-link scrollbar "#151b28"
color-link color-column ",#1b232c"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#6688cc"
color-link trailingws ",#60262d"
color-link tab-error ",#60262d"
