# Monokai Pro. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #727072"
color-link comment.bright "italic #727072"
color-link constant "#ab9df2"
color-link constant.bool "#ab9df2"
color-link constant.number "#ab9df2"
color-link constant.string "#ffd866"
color-link constant.string.char "#ab9df2"
color-link constant.string.url "#ffd866"
color-link constant.specialChar "#fc9867"
color-link identifier "#a9dc76"
color-link identifier.class "#78dce8"
color-link identifier.macro "#a9dc76"
color-link statement "#ff6188"
color-link special "#ff6188"
color-link preproc "#ff6188"
color-link preproc.shebang "italic #727072"
color-link type "#78dce8"
color-link type.keyword "#78dce8"
color-link symbol "#8e8d8d"
color-link symbol.operator "#ff6188"
color-link symbol.brackets "#8e8d8d"
color-link symbol.tag "#ff6188"
color-link symbol.tag.extended "#78dce8"
color-link underlined "underline #ffd866"
color-link error "underline #ff6188"
color-link todo "bold #727072"
color-link selection "#fcfcfa,#5b595c"
color-link cursor-line ",#39363a"
color-link line-number "#5b595c"
color-link current-line-number "#c1c0c0"
color-link indent-char "#423f42"
color-link match-brace "#fcfcfa,#5b595c"
color-link hlsearch "#fcfcfa,#6c3b1f"
color-link tabbar "#8e8d8d,#222023"
color-link tabbar.active "#ffd866,#2d2a2e"
color-link statusline "#8e8d8d,#222023"
color-link statusline.inactive "#8e8d8d,#222023"
color-link statusline.suggestions "#c1c0c0,#222023"
color-link divider "#4a484b"
color-link scrollbar "#4b4a4c"
color-link color-column ",#3a383b"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#fcfcfa"
color-link trailingws ",#7b383a"
color-link tab-error ",#7b383a"
