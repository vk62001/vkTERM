# Dracula. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#6272a4"
color-link comment.bright "#6272a4"
color-link constant "#bd93f9"
color-link constant.bool "#bd93f9"
color-link constant.number "#bd93f9"
color-link constant.string "#f1fa8c"
color-link constant.string.char "#bd93f9"
color-link constant.string.url "underline #8be9fd"
color-link constant.specialChar "#ff79c6"
color-link identifier "#50fa7b"
color-link identifier.class "#8be9fd"
color-link identifier.var "#f8f8f2"
color-link identifier.macro "#50fa7b"
color-link statement "#ff79c6"
color-link special "#ff79c6"
color-link preproc "#ff79c6"
color-link preproc.shebang "#6272a4"
color-link type "italic #8be9fd"
color-link type.keyword "#ff79c6"
color-link symbol.operator "#ff79c6"
color-link symbol.tag "#ff79c6"
color-link symbol.tag.extended "italic #50fa7b"
color-link underlined "underline #8be9fd"
color-link error "italic underline #ff5555"
color-link todo "bold #6272a4"
color-link selection "#f8f8f2,#44475a"
color-link cursor-line ",#44475a"
color-link line-number "#6272a4"
color-link current-line-number "#c6c6c6"
color-link indent-char "#3e404a"
color-link match-brace "#f8f8f2,#888888"
color-link hlsearch "#f8f8f2,#5e5f68"
color-link tabbar "#6272a4,#191a21"
color-link tabbar.active "#f8f8f2,#282a36"
color-link statusline "#6272a4,#191a21"
color-link statusline.inactive "#6272a4,#191a21"
color-link statusline.suggestions "#f8f8f2,#21222c"
color-link divider "#66686e"
color-link scrollbar "#484a51"
color-link color-column ",#2f313c"
color-link diff-added "#3c9259"
color-link diff-modified "#5a8a9a"
color-link diff-deleted "#944046"
color-link gutter-error "#ff5555"
color-link gutter-warning "#8be9fd"
color-link gutter-info "#59a4f9"
color-link error-message "#ff5555"
color-link message "#f8f8f2"
color-link trailingws ",#7e3b42"
color-link tab-error ",#7e3b42"
