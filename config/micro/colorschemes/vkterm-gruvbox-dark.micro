# Gruvbox Dark. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #928374"
color-link comment.bright "italic #928374"
color-link constant "#d3869b"
color-link constant.bool "#d3869b"
color-link constant.number "#d3869b"
color-link constant.string "#b8bb26"
color-link constant.string.char "#d3869b"
color-link constant.string.url "underline #d3869b"
color-link constant.specialChar "#d3869b"
color-link identifier "#fabd2f"
color-link identifier.class "#fabd2f"
color-link identifier.var "#83a598"
color-link identifier.macro "#fabd2f"
color-link statement "#fb4934"
color-link special "#fb4934"
color-link preproc "#8ec07c"
color-link preproc.shebang "italic #928374"
color-link type "#fabd2f"
color-link type.keyword "#fe8019"
color-link symbol "#a89984"
color-link symbol.operator "#8ec07c"
color-link symbol.brackets "#a89984"
color-link symbol.tag "#8ec07c"
color-link symbol.tag.extended "#fabd2f"
color-link underlined "underline #d3869b"
color-link error "#cc241d"
color-link todo "bold #928374"
color-link selection "#ebdbb2,#384539"
color-link cursor-line ",#302e2d"
color-link line-number "#665c54"
color-link current-line-number "#c6c6c6"
color-link indent-char "#383634"
color-link match-brace "#ebdbb2,#5d564e"
color-link hlsearch "#ebdbb2,#503925"
color-link tabbar "#a89984,#282828"
color-link tabbar.active "#ebdbb2,#3c3836"
color-link statusline "#a89984,#282828"
color-link statusline.inactive "#a89984,#282828"
color-link statusline.suggestions "#ebdbb2,#282828"
color-link divider "#625e51"
color-link scrollbar "#403c39"
color-link color-column ",#32302f"
color-link diff-added "#b8bb26"
color-link diff-modified "#83a598"
color-link diff-deleted "#fb4934"
color-link gutter-error "#cc241d"
color-link gutter-warning "#d79921"
color-link gutter-info "#458588"
color-link error-message "#cc241d"
color-link message "#ebdbb2"
color-link trailingws ",#6a2624"
color-link tab-error ",#6a2624"
