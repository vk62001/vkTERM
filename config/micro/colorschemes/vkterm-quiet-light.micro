# Quiet Light. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #aaaaaa"
color-link comment.bright "italic #aaaaaa"
color-link constant "#9c5d27"
color-link constant.bool "#9c5d27"
color-link constant.number "#9c5d27"
color-link constant.string "#448c27"
color-link constant.string.char "#9c5d27"
color-link constant.string.url "#448c27"
color-link constant.specialChar "#777777"
color-link identifier "bold #aa3731"
color-link identifier.class "bold #7a3e9d"
color-link identifier.var "#7a3e9d"
color-link identifier.macro "bold #aa3731"
color-link statement "#4b69c6"
color-link special "#4b69c6"
color-link preproc "#4b69c6"
color-link preproc.shebang "italic #aaaaaa"
color-link type "#7a3e9d"
color-link type.keyword "#7a3e9d"
color-link symbol "#777777"
color-link symbol.operator "#777777"
color-link symbol.brackets "#777777"
color-link symbol.tag "#4b69c6"
color-link error "#660000"
color-link todo "bold #aaaaaa"
color-link underlined "underline #006ab1"
color-link selection "#333333,#c9d0d9"
color-link cursor-line ",#e4f6d4"
color-link line-number "#6d705b"
color-link current-line-number "#9769dc"
color-link indent-char "#d9d9d9"
color-link match-brace "#333333,#b9b9b9"
color-link hlsearch "#333333,#f0dbe4"
color-link tabbar "#54494b,#f3f3f3"
color-link tabbar.active "#333333,#f5f5f5"
color-link statusline "#54494b,#f3f3f3"
color-link statusline.inactive "#54494b,#f3f3f3"
color-link statusline.suggestions "#616161,#f3f3f3"
color-link divider "#cccccc"
color-link scrollbar "#bbbbbb"
color-link color-column ",#ebebeb"
color-link diff-added "#48985d"
color-link diff-modified "#2090d3"
color-link diff-deleted "#e51400"
color-link gutter-error "#e51400"
color-link gutter-warning "#bf8803"
color-link gutter-info "#0063d3"
color-link error-message "#e51400"
color-link message "#333333"
color-link trailingws ",#ef9b93"
color-link tab-error ",#ef9b93"
