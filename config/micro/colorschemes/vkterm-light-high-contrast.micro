# Light High Contrast. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#515151"
color-link comment.bright "#515151"
color-link constant "#0f4a85"
color-link constant.bool "#0f4a85"
color-link constant.number "#096d48"
color-link constant.string "#0f4a85"
color-link constant.string.char "#0f4a85"
color-link constant.string.url "#0f4a85"
color-link constant.specialChar "#ee0000"
color-link identifier "#5e2cbc"
color-link identifier.class "#185e73"
color-link identifier.var "#001080"
color-link identifier.macro "#0f4a85"
color-link statement "#b5200d"
color-link special "#b5200d"
color-link preproc "#b5200d"
color-link preproc.shebang "#515151"
color-link type "#185e73"
color-link type.keyword "#0f4a85"
color-link symbol.operator "#000000"
color-link symbol.tag "#0f4a85"
color-link symbol.tag.extended "#264f78"
color-link error "#b5200d"
color-link todo "bold #515151"
color-link underlined "underline #0f4a85"
color-link selection "#ffffff,#0f4a85"
color-link cursor-line "default"
color-link line-number "#292929"
color-link current-line-number "#006bbd"
color-link indent-char "#cccccc"
color-link match-brace "#ffffff,#0f4a85"
color-link hlsearch "#ffffff,#0f4a85"
color-link tabbar "#292929,#ffffff"
color-link tabbar.active "#292929,#ffffff"
color-link statusline "#292929,#ffffff"
color-link statusline.inactive "#292929,#ffffff"
color-link statusline.suggestions "#292929,#ffffff"
color-link divider "#0f4a85"
color-link scrollbar "#9fb7ce"
color-link color-column ",#bfbfbf"
color-link diff-added "#48985d"
color-link diff-modified "#2090d3"
color-link diff-deleted "#b5200d"
color-link gutter-error "#b5200d"
color-link gutter-warning "#895503"
color-link gutter-info "#0063d3"
color-link error-message "#b5200d"
color-link message "#292929"
color-link trailingws ",#e1a69e"
color-link tab-error ",#e1a69e"
