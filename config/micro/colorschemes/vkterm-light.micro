# vkTERM — esquema de 16 colores ANSI para los temas claros (⌘K ⌘T).
# Igual que vkterm.micro, salvo lo que en un tema claro dependería de colores
# oscuros: la línea del cursor no se resalta (el color 0 es casi negro) y las
# barras de estado y de pestañas van en vídeo inverso, que se lee en cualquier
# paleta.
color-link default "default,default"
color-link comment "brightblack"
color-link constant "magenta"
color-link constant.string "green"
color-link constant.specialChar "cyan"
color-link identifier "blue"
color-link statement "magenta"
color-link symbol "cyan"
color-link symbol.brackets "default"
color-link symbol.tag "blue"
color-link preproc "yellow"
color-link type "yellow"
color-link special "red"
color-link ignore "default"
color-link error ",red"
color-link todo "black,yellow"
color-link hlsearch "black,yellow"
color-link statusline "reverse"
color-link tabbar "reverse"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "default"
color-link cursor-line "default"
color-link color-column "default"
color-link divider "brightblack"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link match-brace "black,cyan"
color-link tab-error "red"
color-link trailingws "red"
