# Dark Modern. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#6a9955"
color-link comment.bright "#6a9955"
color-link constant "#569cd6"
color-link constant.bool "#569cd6"
color-link constant.number "#b5cea8"
color-link constant.string "#ce9178"
color-link constant.string.char "#569cd6"
color-link constant.string.url "#ce9178"
color-link constant.specialChar "#d7ba7d"
color-link identifier "#dcdcaa"
color-link identifier.class "#4ec9b0"
color-link identifier.var "#9cdcfe"
color-link identifier.macro "#569cd6"
color-link statement "#c586c0"
color-link special "#c586c0"
color-link preproc "#c586c0"
color-link preproc.shebang "#6a9955"
color-link type "#4ec9b0"
color-link type.keyword "#569cd6"
color-link symbol.operator "#d4d4d4"
color-link symbol.tag "#569cd6"
color-link symbol.tag.extended "#9cdcfe"
color-link error "#f44747"
color-link todo "bold #6a9955"
color-link underlined "underline #4daafc"
color-link selection "#cccccc,#264f78"
color-link cursor-line ",#282828"
color-link line-number "#6e7681"
color-link current-line-number "#cccccc"
color-link indent-char "#404040"
color-link match-brace "#1f1f1f,#888888"
color-link hlsearch "#cccccc,#633315"
color-link tabbar "#9d9d9d,#181818"
color-link tabbar.active "#ffffff,#1f1f1f"
color-link statusline "#9d9d9d,#181818"
color-link statusline.inactive "#9d9d9d,#181818"
color-link statusline.suggestions "#cccccc,#222222"
color-link divider "#333333"
color-link scrollbar "#434343"
color-link color-column ",#313131"
color-link diff-added "#2ea043"
color-link diff-modified "#0078d4"
color-link diff-deleted "#f85149"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#cccccc"
color-link trailingws ",#733131"
color-link tab-error ",#733131"
