# Nord. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#616e88"
color-link comment.bright "#616e88"
color-link constant "#81a1c1"
color-link constant.bool "#81a1c1"
color-link constant.number "#b48ead"
color-link constant.string "#a3be8c"
color-link constant.string.char "#ebcb8b"
color-link constant.string.url "#a3be8c"
color-link constant.specialChar "#ebcb8b"
color-link identifier "#88c0d0"
color-link identifier.class "#8fbcbb"
color-link identifier.var "#d8dee9"
color-link identifier.macro "#88c0d0"
color-link statement "#81a1c1"
color-link special "#81a1c1"
color-link preproc "#81a1c1"
color-link preproc.shebang "#616e88"
color-link type "#8fbcbb"
color-link type.keyword "#81a1c1"
color-link symbol "#eceff4"
color-link symbol.operator "#81a1c1"
color-link symbol.brackets "#eceff4"
color-link symbol.tag "#81a1c1"
color-link symbol.tag.extended "#8fbcbb"
color-link error "#d8dee9"
color-link todo "bold #616e88"
color-link underlined "underline #88c0d0"
color-link selection "#d8dee9,#3f4758"
color-link cursor-line ",#3b4252"
color-link line-number "#4c566a"
color-link current-line-number "#d8dee9"
color-link indent-char "#3d4555"
color-link match-brace "#2e3440,#88c0d0"
color-link hlsearch "#d8dee9,#40505d"
color-link tabbar "#727884,#2e3440"
color-link tabbar.active "#d8dee9,#3b4252"
color-link statusline "#727884,#2e3440"
color-link statusline.inactive "#727884,#2e3440"
color-link statusline.suggestions "#d8dee9,#2e3440"
color-link divider "#616773"
color-link scrollbar "#3b4252"
color-link color-column ",#343b49"
color-link diff-added "#a3be8c"
color-link diff-modified "#ebcb8b"
color-link diff-deleted "#bf616a"
color-link gutter-error "#bf616a"
color-link gutter-warning "#ebcb8b"
color-link gutter-info "#59a4f9"
color-link error-message "#bf616a"
color-link message "#d8dee9"
color-link trailingws ",#684651"
color-link tab-error ",#684651"
