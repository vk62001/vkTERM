# Cobalt2. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #0088ff"
color-link comment.bright "italic #0088ff"
color-link constant "#ff628c"
color-link constant.bool "#ff628c"
color-link constant.number "#ff628c"
color-link constant.string "#a5ff90"
color-link constant.string.char "#ff628c"
color-link constant.string.url "#a5ff90"
color-link constant.specialChar "#ff628c"
color-link identifier "#ffc600"
color-link identifier.class "#ffc600"
color-link identifier.var "#e1efff"
color-link identifier.macro "#ffc600"
color-link statement "#ff9d00"
color-link special "#ff9d00"
color-link preproc "#ff9d00"
color-link preproc.shebang "italic #0088ff"
color-link type "#80ffbb"
color-link type.keyword "#ffc600"
color-link symbol "#e1efff"
color-link symbol.operator "#ff9d00"
color-link symbol.brackets "#e1efff"
color-link symbol.tag "#9effff"
color-link symbol.tag.extended "#ffc600"
color-link error "#f44542"
color-link todo "bold #0088ff"
color-link underlined "underline #0088ff"
color-link selection "#ffffff,#0050a4"
color-link cursor-line ",#1f4662"
color-link line-number "#aaaaaa"
color-link current-line-number "#c6c6c6"
color-link indent-char "#3b5364"
color-link match-brace "#ffffff,#8c7e24"
color-link hlsearch "#ffffff,#607532"
color-link tabbar "#aaaaaa,#122738"
color-link tabbar.active "#ffffff,#193549"
color-link statusline "#aaaaaa,#122738"
color-link statusline.inactive "#aaaaaa,#122738"
color-link statusline.suggestions "#aaaaaa,#15232d"
color-link divider "#5e7280"
color-link scrollbar "#38586f"
color-link color-column ",#1b3a50"
color-link diff-added "#3c9f4a"
color-link diff-modified "#26506d"
color-link diff-deleted "#a22929"
color-link gutter-error "#a22929"
color-link gutter-warning "#ffc600"
color-link gutter-info "#59a4f9"
color-link error-message "#a22929"
color-link message "#ffffff"
color-link trailingws ",#50303c"
color-link tab-error ",#50303c"
