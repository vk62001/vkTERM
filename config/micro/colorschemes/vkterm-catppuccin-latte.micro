# Catppuccin Latte. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #7c7f93"
color-link comment.bright "italic #7c7f93"
color-link constant "#d20f39"
color-link constant.bool "#fe640b"
color-link constant.number "#fe640b"
color-link constant.string "#40a02b"
color-link constant.string.char "#40a02b"
color-link constant.string.url "#1e66f5"
color-link constant.specialChar "#ea76cb"
color-link identifier "italic #1e66f5"
color-link identifier.class "italic #df8e1d"
color-link identifier.macro "italic #1e66f5"
color-link statement "#8839ef"
color-link special "#8839ef"
color-link preproc "#df8e1d"
color-link preproc.shebang "italic #7c7f93"
color-link type "italic #df8e1d"
color-link type.keyword "#8839ef"
color-link symbol "#7c7f93"
color-link symbol.operator "#179299"
color-link symbol.brackets "#7c7f93"
color-link symbol.tag "#1e66f5"
color-link symbol.tag.extended "#df8e1d"
color-link underlined "underline #1e66f5"
color-link todo "bold #7c7f93"
color-link error "underline #d20f39"
color-link selection "#4c4f69,#cccfd7"
color-link cursor-line ",#e3e6eb"
color-link line-number "#8c8fa1"
color-link current-line-number "#8839ef"
color-link indent-char "#bcc0cc"
color-link match-brace "#eff1f5,#7c7f93"
color-link hlsearch "#4c4f69,#a9daf0"
color-link tabbar "#9ca0b0,#dce0e8"
color-link tabbar.active "#8839ef,#eff1f5"
color-link statusline "#9ca0b0,#dce0e8"
color-link statusline.inactive "#9ca0b0,#dce0e8"
color-link statusline.suggestions "#4c4f69,#e6e9ef"
color-link divider "#acb0be"
color-link scrollbar "#cdd0d9"
color-link color-column ",#dbdee4"
color-link diff-added "#40a02b"
color-link diff-modified "#df8e1d"
color-link diff-deleted "#d20f39"
color-link gutter-error "#d20f39"
color-link gutter-warning "#fe640b"
color-link gutter-info "#1e66f5"
color-link error-message "#d20f39"
color-link message "#4c4f69"
color-link trailingws ",#e397aa"
color-link tab-error ",#e397aa"
