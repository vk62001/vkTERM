# Kimbie Dark. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#a57a4c"
color-link comment.bright "#a57a4c"
color-link constant "#f79a32"
color-link constant.bool "#f79a32"
color-link constant.number "#f79a32"
color-link constant.string "#889b4a"
color-link constant.string.char "#f79a32"
color-link constant.string.url "#889b4a"
color-link constant.specialChar "#7e602c"
color-link identifier "#8ab1b0"
color-link identifier.class "#f06431"
color-link identifier.var "#dc3958"
color-link identifier.macro "#8ab1b0"
color-link statement "#98676a"
color-link special "#98676a"
color-link preproc "#98676a"
color-link preproc.shebang "#a57a4c"
color-link type "#f06431"
color-link type.keyword "#98676a"
color-link symbol.operator "#d3af86"
color-link symbol.tag "#dc3958"
color-link symbol.tag.extended "#f79a32"
color-link error "#dc3958"
color-link todo "bold #a57a4c"
color-link underlined "underline #3794ff"
color-link selection "#d3af86,#63492e"
color-link cursor-line ",#5e452b"
color-link line-number "#858585"
color-link current-line-number "#adadad"
color-link indent-char "#a57a4c"
color-link match-brace "#221a0f,#888888"
color-link hlsearch "#d3af86,#65300a"
color-link tabbar "#898a88,#131510"
color-link tabbar.active "#ffffff,#221a0f"
color-link statusline "#898a88,#131510"
color-link statusline.inactive "#898a88,#131510"
color-link statusline.suggestions "#cccccc,#131510"
color-link divider "#444444"
color-link scrollbar "#454039"
color-link color-column ",#332d26"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#d3af86"
color-link trailingws ",#752e27"
color-link tab-error ",#752e27"
