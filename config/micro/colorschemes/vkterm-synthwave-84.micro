# SynthWave '84. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #848bbd"
color-link comment.bright "italic #848bbd"
color-link constant "#f97e72"
color-link constant.bool "#f97e72"
color-link constant.number "#f97e72"
color-link constant.string.char "#f97e72"
color-link constant.string.url "#dd5500"
color-link constant.specialChar "#36f9f6"
color-link identifier "#36f9f6"
color-link identifier.class "#fe4450"
color-link identifier.var "#ff7edb"
color-link identifier.macro "#36f9f6"
color-link statement "#fede5d"
color-link special "#fede5d"
color-link preproc "#fede5d"
color-link preproc.shebang "italic #848bbd"
color-link type "#fe4450"
color-link type.keyword "#fede5d"
color-link symbol.operator "#fede5d"
color-link symbol.tag "#72f1b8"
color-link symbol.tag.extended "#fede5d"
color-link underlined "underline #dd5500"
color-link todo "bold #848bbd"
color-link error "underline #fe4450"
color-link selection "#bbbbbb,#413f4e"
color-link cursor-line ",#443964"
color-link line-number "#888690"
color-link current-line-number "#d4d3d7"
color-link indent-char "#444251"
color-link match-brace "#bbbbbb,#495495"
color-link hlsearch "#bbbbbb,#5f442b"
color-link tabbar "#92919a,#241b2f"
color-link tabbar.active "#ffffff,#262335"
color-link statusline "#928d97,#241b2f"
color-link statusline.inactive "#928d97,#241b2f"
color-link statusline.suggestions "#ffffff,#191723"
color-link divider "#495495"
color-link scrollbar "#3c3751"
color-link color-column ",#392947"
color-link diff-added "#216147"
color-link diff-modified "#78628b"
color-link diff-deleted "#ae2a40"
color-link gutter-error "#fe4450"
color-link gutter-warning "#63c89e"
color-link gutter-info "#59a4f9"
color-link error-message "#fe4450"
color-link message "#bbbbbb"
color-link trailingws ",#7c3040"
color-link tab-error ",#7c3040"
