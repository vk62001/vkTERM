# Tomorrow Night Blue. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "#7285b7"
color-link comment.bright "#7285b7"
color-link constant "#ffc58f"
color-link constant.bool "#ffc58f"
color-link constant.number "#ffc58f"
color-link constant.string "#d1f1a9"
color-link constant.string.char "#ffc58f"
color-link constant.string.url "#d1f1a9"
color-link constant.specialChar "#ffc58f"
color-link identifier "#bbdaff"
color-link identifier.class "#ffeead"
color-link identifier.var "#ff9da4"
color-link identifier.macro "#bbdaff"
color-link statement "#ebbbff"
color-link special "#ebbbff"
color-link preproc "#ebbbff"
color-link preproc.shebang "#7285b7"
color-link type "#ffeead"
color-link type.keyword "#ebbbff"
color-link symbol.operator "#99ffff"
color-link symbol.tag "#ff9da4"
color-link symbol.tag.extended "#ff9da4"
color-link error "#a92049"
color-link todo "bold #7285b7"
color-link underlined "underline #3794ff"
color-link selection "#ffffff,#003f8e"
color-link cursor-line ",#00346e"
color-link line-number "#858585"
color-link current-line-number "#949494"
color-link indent-char "#404f7d"
color-link match-brace "#ffffff,#888888"
color-link hlsearch "#ffffff,#4e3736"
color-link tabbar "#808ea0,#001733"
color-link tabbar.active "#ffffff,#002451"
color-link statusline "#808b99,#001733"
color-link statusline.inactive "#808b99,#001733"
color-link statusline.suggestions "#cccccc,#001c40"
color-link divider "#404f7d"
color-link scrollbar "#304661"
color-link color-column ",#1b3454"
color-link diff-added "#487e02"
color-link diff-modified "#1b81a8"
color-link diff-deleted "#f14c4c"
color-link gutter-error "#f14c4c"
color-link gutter-warning "#cca700"
color-link gutter-info "#59a4f9"
color-link error-message "#f14c4c"
color-link message "#ffffff"
color-link trailingws ",#60344f"
color-link tab-error ",#60344f"
