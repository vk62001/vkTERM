# Shades of Purple. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #b362ff"
color-link comment.bright "italic #b362ff"
color-link constant "#ff628c"
color-link constant.bool "#ff628c"
color-link constant.number "#ff628c"
color-link constant.string "#a5ff90"
color-link constant.string.char "#ff628c"
color-link constant.string.url "#a5ff90"
color-link constant.specialChar "#ff628c"
color-link identifier "#fad000"
color-link identifier.class "#fad000"
color-link identifier.var "#e1efff"
color-link identifier.macro "#fad000"
color-link statement "#ff9d00"
color-link special "#ff9d00"
color-link preproc "#ff9d00"
color-link preproc.shebang "italic #b362ff"
color-link type "#80ffbb"
color-link type.keyword "#ff9d00"
color-link symbol "#e1efff"
color-link symbol.operator "#ff9d00"
color-link symbol.brackets "#e1efff"
color-link symbol.tag "#9effff"
color-link symbol.tag.extended "italic #fad000"
color-link error "#e53938"
color-link todo "bold #b362ff"
color-link underlined "underline #b362ff"
color-link selection "#ffffff,#7448b0"
color-link cursor-line ",#1f1f41"
color-link line-number "#a599e9"
color-link current-line-number "#c6c6c6"
color-link indent-char "#34315e"
color-link match-brace "#ffffff,#503e83"
color-link hlsearch "#ffffff,#595844"
color-link tabbar "#a599e9,#2d2b55"
color-link tabbar.active "#ffffff,#222244"
color-link statusline "#a599e9,#2d2b55"
color-link statusline.inactive "#a599e9,#2d2b55"
color-link statusline.suggestions "#a599e9,#222244"
color-link divider "#6c6b88"
color-link scrollbar "#6a63a0"
color-link color-column ",#312f5a"
color-link diff-added "#35ad68"
color-link diff-modified "#503e83"
color-link diff-deleted "#e53938"
color-link gutter-error "#e53938"
color-link gutter-warning "#fad000"
color-link gutter-info "#59a4f9"
color-link error-message "#e53938"
color-link message "#ffffff"
color-link trailingws ",#773149"
color-link tab-error ",#773149"
