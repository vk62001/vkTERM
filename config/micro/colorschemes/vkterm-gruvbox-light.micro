# Gruvbox Light. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #928374"
color-link comment.bright "italic #928374"
color-link constant "#8f3f71"
color-link constant.bool "#8f3f71"
color-link constant.number "#8f3f71"
color-link constant.string "#79740e"
color-link constant.string.char "#8f3f71"
color-link constant.string.url "underline #8f3f71"
color-link constant.specialChar "#8f3f71"
color-link identifier "#b57614"
color-link identifier.class "#b57614"
color-link identifier.var "#076678"
color-link identifier.macro "#b57614"
color-link statement "#9d0006"
color-link special "#9d0006"
color-link preproc "#427b58"
color-link preproc.shebang "italic #928374"
color-link type "#b57614"
color-link type.keyword "#af3a03"
color-link symbol "#7c6f64"
color-link symbol.operator "#427b58"
color-link symbol.brackets "#7c6f64"
color-link symbol.tag "#427b58"
color-link symbol.tag.extended "#b57614"
color-link underlined "underline #8f3f71"
color-link error "#cc241d"
color-link todo "bold #928374"
color-link selection "#3c3836,#d6dcb0"
color-link cursor-line ",#f5e9bf"
color-link line-number "#bdae93"
color-link current-line-number "#0b216f"
color-link indent-char "#ebe1bb"
color-link match-brace "#3c3836,#c6ba9d"
color-link hlsearch "#3c3836,#edcfa2"
color-link tabbar "#7c6f64,#fbf1c7"
color-link tabbar.active "#3c3836,#ebdbb2"
color-link statusline "#7c6f64,#fbf1c7"
color-link statusline.inactive "#7c6f64,#fbf1c7"
color-link statusline.suggestions "#3c3836,#fbf1c7"
color-link divider "#c2ba9c"
color-link scrollbar "#e4d6b0"
color-link color-column ",#f1e7c0"
color-link diff-added "#79740e"
color-link diff-modified "#076678"
color-link diff-deleted "#9d0006"
color-link gutter-error "#cc241d"
color-link gutter-warning "#d79921"
color-link gutter-info "#458588"
color-link error-message "#cc241d"
color-link message "#3c3836"
color-link trailingws ",#e89f83"
color-link tab-error ",#e89f83"
