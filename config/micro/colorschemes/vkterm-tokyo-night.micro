# Tokyo Night. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #51597d"
color-link comment.bright "italic #51597d"
color-link constant "#ff9e64"
color-link constant.bool "#ff9e64"
color-link constant.number "#ff9e64"
color-link constant.string "#9ece6a"
color-link constant.string.char "#bb9af7"
color-link constant.string.url "underline #73daca"
color-link constant.specialChar "#89ddff"
color-link identifier "#7aa2f7"
color-link identifier.class "#c0caf5"
color-link identifier.var "#c0caf5"
color-link identifier.macro "#7aa2f7"
color-link statement "#bb9af7"
color-link special "#bb9af7"
color-link preproc "#bb9af7"
color-link preproc.shebang "italic #51597d"
color-link type "#0db9d7"
color-link type.keyword "#bb9af7"
color-link symbol "#89ddff"
color-link symbol.operator "#89ddff"
color-link symbol.brackets "#89ddff"
color-link symbol.tag "#f7768e"
color-link symbol.tag.extended "#bb9af7"
color-link underlined "underline #73daca"
color-link error "#ff5370"
color-link todo "bold #51597d"
color-link selection "#a9b1d6,#2b2f41"
color-link cursor-line ",#1e202e"
color-link line-number "#363b54"
color-link current-line-number "#787c99"
color-link indent-char "#232433"
color-link match-brace "#a9b1d6,#42465d"
color-link hlsearch "#a9b1d6,#283457"
color-link tabbar "#787c99,#16161e"
color-link tabbar.active "#a9b1d6,#16161e"
color-link statusline "#787c99,#16161e"
color-link statusline.inactive "#787c99,#16161e"
color-link statusline.suggestions "#787c99,#16161e"
color-link divider "#45485b"
color-link scrollbar "#232433"
color-link color-column ",#171821"
color-link diff-added "#164846"
color-link diff-modified "#394b70"
color-link diff-deleted "#823c41"
color-link gutter-error "#db4b4b"
color-link gutter-warning "#e0af68"
color-link gutter-info "#0da0ba"
color-link error-message "#db4b4b"
color-link message "#a9b1d6"
color-link trailingws ",#672e35"
color-link tab-error ",#672e35"
