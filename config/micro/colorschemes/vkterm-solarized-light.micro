# Solarized Light. Generado por scripts/gen-themes.py: no editar.
# `default` sin colores: el texto y el fondo los pone el terminal
# (Ghostty), para que el atenuado de los paneles sin foco funcione.
color-link default "default,default"
color-link comment "italic #93a1a1"
color-link comment.bright "italic #93a1a1"
color-link constant "#b58900"
color-link constant.bool "#b58900"
color-link constant.number "#d33682"
color-link constant.string "#2aa198"
color-link constant.string.char "#cb4b16"
color-link constant.string.url "#2aa198"
color-link constant.specialChar "#cb4b16"
color-link identifier "#268bd2"
color-link identifier.class "#cb4b16"
color-link identifier.var "#268bd2"
color-link identifier.macro "#268bd2"
color-link statement "#859900"
color-link special "#859900"
color-link preproc "#859900"
color-link preproc.shebang "italic #93a1a1"
color-link type "#859900"
color-link type.keyword "bold #586e75"
color-link symbol.operator "#859900"
color-link symbol.tag "#268bd2"
color-link symbol.tag.extended "#93a1a1"
color-link error "#dc322f"
color-link todo "bold #93a1a1"
color-link underlined "underline #006ab1"
color-link selection "#657b83,#eee8d5"
color-link cursor-line ",#eee8d5"
color-link line-number "#237893"
color-link current-line-number "#567983"
color-link indent-char "#aab2ac"
color-link match-brace "#fdf6e3,#b9b9b9"
color-link hlsearch "#fdf6e3,#f7c397"
color-link tabbar "#586e75,#d9d2c2"
color-link tabbar.active "#333333,#fdf6e3"
color-link statusline "#586e75,#d9d2c2"
color-link statusline.inactive "#586e75,#d9d2c2"
color-link statusline.suggestions "#616161,#eee8d5"
color-link divider "#ddd6c1"
color-link scrollbar "#c0bcb0"
color-link color-column ",#f0ecde"
color-link diff-added "#48985d"
color-link diff-modified "#2090d3"
color-link diff-deleted "#e51400"
color-link gutter-error "#e51400"
color-link gutter-warning "#bf8803"
color-link gutter-info "#0063d3"
color-link error-message "#e51400"
color-link message "#657b83"
color-link trailingws ",#f39c88"
color-link tab-error ",#f39c88"
