+-- vkTERM: Micro llama "typescript" a los .tsx y "javascript" a los .jsx, y el
+-- servidor de TypeScript no entendería el JSX: se anuncian como en VS Code.
+function languageId(buf)
+    local extension = buf.AbsPath:match("%.(%w+)$")
+    if extension == "tsx" then return "typescriptreact" end
+    if extension == "jsx" then return "javascriptreact" end
+    return buf:FileType()
+end
