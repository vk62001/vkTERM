# vkTERM — perfil de Ghostty (probado con Ghostty 1.3.1)
#
# Lo carga vkTERM.app (bin/vkterm-app, scripts/vkterm-app-launcher.c) con
# --config-default-files=false, así que ~/.config/ghostty no se lee ni se
# modifica.
#
# Dos modos por pestaña (o división):
#   - Modo terminal (tabla de atajos por defecto): un terminal como cualquier
#     otro, con las pestañas, divisiones, búsqueda y atajos de Ghostty.
#   - Modo IDE (tabla `vkterm`): el workspace tipo VS Code. `vkterm .` o
#     ⌘B / ⌘J / ⌘P / ⌘⇧P en el prompt convierten la pestaña; bin/vkterm-surface
#     activa la tabla en esa pestaña (AppleScript `perform action`) y la
#     desactiva al salir (⌘K F). Ghostty busca primero en la tabla activa y,
#     si la tecla no está, en la de por defecto: ⌘T, ⌘N o ⌘Q siguen
#     funcionando en el IDE.

# Tema hasta que se elija uno con ⌘K ⌘T: el Catppuccin Mocha de Ghostty, el
# mismo que vkterm-catppuccin-mocha (config/ghostty/themes). Los temas de
# vkTERM se cargan por ruta absoluta (config/local/theme.ghostty) porque
# Ghostty solo busca por nombre en ~/.config/ghostty/themes y en los suyos.
theme = Catppuccin Mocha
window-save-state = never
macos-titlebar-style = transparent
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

# vkTERM.app es una copia de Ghostty: se actualiza con Ghostty y
# `bin/vkterm-app install`, nunca por su cuenta.
auto-update = off
# ssh: los servidores no conocen TERM=xterm-ghostty (nano: «Error opening
# terminal: xterm-ghostty»). La integración de zsh de Ghostty envuelve `ssh`:
# la primera vez instala ese terminfo en ~/.terminfo del servidor y lo
# recuerda (ghostty +ssh-cache); si no puede (sin `tic`), entra con
# TERM=xterm-256color.
shell-integration-features = ssh-env,ssh-terminfo

# ⌥ Option: los dos escriben los caracteres del teclado, como en cualquier
# app de macOS y en VS Code (Spanish - ISO: ⌥2 = @, ⌥3 = #, [ ] { } | \ ~).
# Las combinaciones que no producen un carácter (⌥← / ⌥→) siguen llegando
# como Alt: saltan palabra a palabra.
macos-option-as-alt = false

# ------------------------------------------------------------- modo terminal
#
# ⌘B, ⌘J, ⌘P y ⌘⇧P convierten la pestaña en el IDE de la carpeta actual y
# después hacen lo mismo que en VS Code (mostrar el explorador, el Shell,
# buscar un archivo, la paleta de comandos). Envían F13–F16 con Super, que la
# integración de zsh (config/zsh/vkterm.zsh) recoge en el prompt; fuera de él,
# los programas ignoran esas teclas.
keybind = super+b=csi:25;9~
keybind = super+j=csi:26;9~
keybind = super+p=csi:28;9~
keybind = super+shift+p=csi:29;9~

# ⌘O: «Abrir reciente», como en VS Code (⌃R allí; aquí ⌃R es la búsqueda del
# historial de zsh): la lista de las carpetas ya abiertas en vkTERM. Envía F20
# con Super, que la integración de zsh recoge en el prompt (`vkterm -r`); en
# el IDE abre la misma lista (abajo).
keybind = super+o=csi:34;9~

# ⌘T (pestaña nueva) y ⌘⇧, (recargar la configuración) van por tecla física
# (key_t, comma) y no por carácter. Con el carácter, Ghostty pone el atajo en
# su menú (New Tab, Reload Configuration) y macOS lo resuelve por el menú
# antes que por las tablas: en el IDE, ⌘K ⌘T abría una pestaña en vez del
# selector de tema, y ⌘⇧, recargaba sin volver a activar el modo IDE. Con la
# tecla física, el menú se queda sin atajo y el resultado es el mismo.
keybind = super+t=unbind
keybind = super+key_t=new_tab
keybind = super+shift+,=unbind
keybind = super+shift+comma=reload_config
# ⌘Enter: commit en Control de código fuente (en el IDE, abajo). Ghostty lo
# usa para la pantalla completa y lo pone en su menú, que macOS resolvería
# antes que la tabla del IDE. La pantalla completa sigue en ⌃⌘F, como en las
# demás apps de macOS; en el modo terminal ⌘Enter no hace nada (sin
# `ignore`, llegaría al shell como Enter).
keybind = super+enter=ignore

# ⌘N: ventana nueva en el modo terminal y «Nuevo archivo…» en el IDE (abajo).
# Por tecla física, como ⌘T: con el carácter, el menú (New Window) se quedaría
# el atajo y macOS lo resolvería antes que la tabla del IDE. ⌘⇧N también abre
# una ventana, como en VS Code.
keybind = super+n=unbind
keybind = super+key_n=new_window
keybind = super+shift+key_n=new_window

# ⌘+ ⌘- ⌘0: el tamaño de letra de vkTERM, que se recuerda (bin/vkterm-font),
# en los dos modos. Sustituyen a los de Ghostty: con ellos en su menú (View),
# macOS resolvía ⌘- y ⌘0 por el menú antes que por la tabla del IDE y solo
# cambiaba esa pestaña. En el modo terminal envían F17–F19 con Super, que la
# integración de zsh recoge en el prompt; fuera de él, los programas los
# ignoran. El + del teclado español y el = (⇧0) del de EE. UU.
keybind = super++=csi:31;9~
keybind = super+==csi:31;9~
keybind = super+-=csi:32;9~
keybind = super+0=csi:33;9~

# ⌘C: copia la selección, como siempre. Ghostty 1.3.1 lo trae `performable`
# (sin selección, la tecla pasa al programa), y los atajos `performable` no
# van al menú: Edición › Copiar salía sin ⌘C. Así el menú lo muestra; sin
# selección, ⌘C no hace nada, como en Terminal o iTerm2.
keybind = super+c=copy_to_clipboard:mixed

# ⌘V: pega el texto, como siempre. Con `performable:`, si el portapapeles no
# tiene texto (una captura de pantalla), Ghostty no pega nada y envía la tecla
# al programa, que la recibe si usa el protocolo de teclado de kitty. Claude
# Code y Codex adjuntan la imagen con ⌃V: en el modo terminal corren a través
# de bin/vkterm-agent (config/zsh/vkterm.zsh), que les cambia ese ⌘V por ⌃V.
# En el IDE lo hace el plugin vkterm (abajo). Por ser `performable`,
# Edición › Pegar no muestra ⌘V (pega igual).
keybind = performable:super+v=paste_from_clipboard

# ----------------------------------------------------------------- modo IDE
#
# ⌘ Command: Zellij y Micro nunca reciben la tecla Command. Ghostty traduce
# estos atajos a secuencias que sí entienden:
#   - Alt+tecla (ESC + tecla): códigos internos que Zellij enlaza en
#     config/zellij/config.kdl (activos también en modo locked) y convierte en
#     mensajes al plugin vkterm.
#   - F2 (ESC O Q): Guardar en Micro. No se usa Ctrl-S porque congela la
#     salida de los comandos en los shells (control de flujo XON/XOFF).

# ⌘1..⌘5: Explorador, Editor, Claude Code, Codex, Shell (por identidad; si el
# panel está oculto, se muestra). Se cubren la tecla física (digit_N) y el
# carácter (N); en el modo terminal cambian de pestaña.
keybind = vkterm/super+digit_1=esc:1
keybind = vkterm/super+digit_2=esc:2
keybind = vkterm/super+digit_3=esc:3
keybind = vkterm/super+digit_4=esc:4
keybind = vkterm/super+digit_5=esc:5
keybind = vkterm/super+1=esc:1
keybind = vkterm/super+2=esc:2
keybind = vkterm/super+3=esc:3
keybind = vkterm/super+4=esc:4
keybind = vkterm/super+5=esc:5

# Como VS Code: ⌘B barra lateral (explorador), ⌘J panel (Shell), ⌥⌘B barra
# secundaria (Claude Code y Codex). Muestran / ocultan sin cerrar procesos.
# ⌥⌘B se cubre por tecla física y por carácter (con el ⌥ izquierdo, macOS
# convierte la b en otro carácter).
keybind = vkterm/super+b=esc:6
keybind = vkterm/super+j=esc:7
keybind = vkterm/super+alt+b=esc:8
keybind = vkterm/super+alt+key_b=esc:8

# Pestañas del editor, como VS Code: ⌘⌥← / ⌘⌥→ y ⌃⇧Tab / ⌃Tab (en el modo
# terminal son las divisiones y pestañas de Ghostty). ⌘W cierra la pestaña
# del editor; en el modo terminal cierra la de Ghostty. ⌘⌥↑ / ⌘⌥↓ mueven el
# foco al panel de arriba / abajo (editor ↔ Shell).
keybind = vkterm/super+alt+arrow_left=esc:,
keybind = vkterm/super+alt+arrow_right=esc:.
keybind = vkterm/ctrl+shift+tab=esc:,
keybind = vkterm/ctrl+tab=esc:.
keybind = vkterm/super+w=esc:9
keybind = vkterm/super+alt+arrow_up=esc:k
keybind = vkterm/super+alt+arrow_down=esc:j

# ⌘P: abrir archivo por nombre (búsqueda difusa) y ⌘⇧P: paleta de comandos,
# como VS Code. Las dos son la misma ventana flotante del plugin vkterm.
keybind = vkterm/super+p=esc:0
keybind = vkterm/super+shift+p=esc:;

# Lenguaje (LSP), como VS Code: ⌘I sugerencias, ⌘K ⌘I información, ⇧F12
# referencias, ⌘K ⌘F dar formato, ⌘K ⌘R cambiar el nombre del símbolo y ⌘⇧O
# símbolos del archivo. F12 (definición) lo recibe Micro sin pasar por aquí.
keybind = vkterm/super+i=esc:>
keybind = vkterm/super+k>super+i=esc:^
keybind = vkterm/shift+f12=esc:|
keybind = vkterm/super+k>super+f=esc:~
keybind = vkterm/super+k>super+r=esc:@
keybind = vkterm/super+shift+o=esc:}

# ⌘⇧F: buscar (y reemplazar) en todo el proyecto.
keybind = vkterm/super+shift+f=esc:{

# ⌘S: guardar en Micro.
keybind = vkterm/super+s=esc:OQ

# ⌘N: «Nuevo archivo…», como en VS Code: pide el nombre y lo crea en la
# carpeta seleccionada del explorador. ⌘⇧N abre una ventana (arriba).
keybind = vkterm/super+n=esc:d

# ⌘R: «Renombrar…» el archivo o carpeta seleccionado del explorador. VS Code
# usa F2 (o Enter), que aquí no sirven: no todos los teclados tienen F2 y
# Enter abre. En el modo terminal, ⌘R no hace nada especial.
keybind = vkterm/super+r=esc:_

# ⌘.: el menú del clic derecho del explorador para lo seleccionado. Zellij
# 0.45.1 no les pasa el clic derecho a los plugins. ⇧F10, el atajo de VS
# Code, también sirve con el foco en el explorador (lo recibe el plugin).
keybind = vkterm/super+period=esc::

# ⌘K ⌘S: ventana de atajos, como en VS Code (secuencia: ⌘K y después ⌘S).
# Ghostty espera la segunda tecla sin límite de tiempo; si no es una de las
# de abajo, envía las dos al programa. En el modo terminal ⌘K limpia la
# pantalla, como siempre.
keybind = vkterm/super+k>super+s=esc:?

# ⌘K Z: ampliar o restaurar el panel con el foco, como el modo Zen de VS Code
# (secuencia: ⌘K y después Z).
# ⌘K ⌘C: copia todo el historial del panel con el foco (Claude Code, Codex,
# Shell), porque seleccionar con el ratón se rompe al girar la rueda.
keybind = vkterm/super+k>super+c=esc:+
keybind = vkterm/super+k>z=esc:z

# ⌘K ⌘T: tema de color, como en VS Code (secuencia: ⌘K y después ⌘T).
keybind = vkterm/super+k>super+t=esc:t

# ⌘K ⌘L: fuente (tipo de letra y tamaño), con prueba en vivo, como el
# selector de tema. VS Code no tiene uno: la L es de «letra».
keybind = vkterm/super+k>super+l=esc:g

# ⌘+ / ⌘- / ⌘0: tamaño de letra, como en VS Code, y se recuerda
# (bin/vkterm-font). Por carácter: el + del teclado español y el = del de
# EE. UU. (En el modo terminal, ver arriba.)
keybind = vkterm/super++=esc:m
keybind = vkterm/super+==esc:m
keybind = vkterm/super+-=esc:w
keybind = vkterm/super+0=esc:e

# ⌘K F: cerrar la carpeta, como «File: Close Folder» de VS Code. Termina la
# sesión del IDE (Micro, Claude Code, Codex) y vuelve al modo terminal, con
# el shell de antes intacto.
keybind = vkterm/super+k>f=esc:q
# Control de código fuente, como en VS Code: ⌃⇧G muestra la vista con los
# cambios de git y los conflictos (también los que habría al fusionar otra
# rama) y ⌘⇧E vuelve al explorador; las dos están en la misma barra lateral.
# ⌘Enter hace commit en esa vista (fuera de ella no hace nada). En el modo
# terminal no hacen nada especial.
keybind = vkterm/ctrl+shift+g=esc:/
keybind = vkterm/super+shift+e=esc:'
keybind = vkterm/super+enter=esc:*

# ⌘O: «Abrir reciente», como «File: Open Recent» de VS Code: Enter abre la
# carpeta en esta pestaña (cierra antes la actual, preguntando si se perdería
# algo) y ⇧Enter en una ventana nueva.
keybind = vkterm/super+o=esc:b

# ⌘← / ⌘→: inicio / fin de línea (Home / End). Por defecto Ghostty envía
# Ctrl-A / Ctrl-E, que en Micro son "seleccionar todo" y "línea de comandos".
keybind = vkterm/super+arrow_left=csi:H
keybind = vkterm/super+arrow_right=csi:F

# Edición, como VS Code: ⌘Z / ⌘⇧Z deshacer / rehacer, ⌘A seleccionar todo,
# ⌘F buscar, ⌘X cortar. Llegan al plugin vkterm, que las pasa a Micro solo si
# el editor tiene el foco: en un shell, Ctrl-Z suspendería el proceso. En el
# modo terminal son las de Ghostty (deshacer, seleccionar y buscar en la
# pantalla).
keybind = vkterm/super+z=esc:u
keybind = vkterm/super+shift+z=esc:y
keybind = vkterm/super+a=esc:a
keybind = vkterm/super+f=esc:s
keybind = vkterm/super+x=esc:x

# ⌘C: copia la selección de Ghostty, como siempre, y en el editor la de Micro
# (sin selección, la línea, como VS Code). Nunca envía Ctrl-C a un shell.
keybind = vkterm/super+c=copy_to_clipboard:mixed
keybind = chain=esc:c

# ⌘V: pega el texto, como siempre (bracketed paste). En Claude Code y Codex,
# si el portapapeles solo tiene una imagen, el plugin vkterm les manda ⌃V, con
# el que la adjuntan (un terminal no puede pegar imágenes).
keybind = vkterm/super+v=paste_from_clipboard
keybind = chain=esc:v

# Edición avanzada, como VS Code. Igual que las anteriores, llegan al plugin
# vkterm, que las pasa a Micro solo si el editor tiene el foco.
#   ⌘D  añadir un cursor en la siguiente coincidencia (multicursor)
#   ⌘/  comentar o descomentar la línea
#   ⌘] ⌘[  indentar y quitar sangría
#   ⌘G ⌘⇧G  siguiente / anterior coincidencia de la búsqueda
#   ⌘L  seleccionar la línea       ⌘⇧K  borrar la línea
#   ⌘↑ ⌘↓  principio / fin del archivo
# ⌥↑ ⌥↓ mueven la línea y ⌥⇧↑ ⌥⇧↓ la duplican: son teclas de Micro
# (config/micro/bindings.json) y no necesitan atajo aquí.
keybind = vkterm/super+d=esc:!
keybind = vkterm/super+/=esc:#
keybind = vkterm/super+shift+7=esc:#
keybind = vkterm/super+bracket_right=esc:$
keybind = vkterm/super+bracket_left=esc:%
keybind = vkterm/super+g=esc:&
keybind = vkterm/super+shift+g=esc:(
keybind = vkterm/super+l=esc:)
keybind = vkterm/super+shift+k=esc:<
keybind = vkterm/super+arrow_up=csi:1;5H
keybind = vkterm/super+arrow_down=csi:1;5F

# ⌘⇧D: Zellij gestiona los paneles del IDE; no se divide su pestaña. En el
# modo terminal es la división de Ghostty.
keybind = vkterm/super+shift+d=ignore

# ⌘⇧,: recargar la configuración. Ghostty vacía las tablas de atajos al
# recargar: el plugin vkterm recarga con bin/vkterm-theme, que después vuelve
# a activar el modo IDE en sus pestañas.
keybind = vkterm/super+shift+comma=esc:r

# Ajustes propios (opcional, fuera de git), antes de la fuente y del tema.
config-file = ?../local/user.ghostty

# Fuente y tamaño elegidos con ⌘K ⌘L, ⌘+, ⌘- y ⌘0 (bin/vkterm-font): mandan
# sobre los de user.ghostty.
config-file = ?../local/font.ghostty

# Tema elegido con ⌘K ⌘T (bin/vkterm-theme). Ghostty carga este archivo al
# final, así que sustituye al `theme` de arriba; "?": si no existe (no se ha
# elegido ninguno), se queda Catppuccin Mocha.
config-file = ?../local/theme.ghostty
