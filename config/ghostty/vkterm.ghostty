# vkTERM — perfil de Ghostty (probado con Ghostty 1.3.1)
#
# Lo carga vkTERM.app (bin/vkterm-app, scripts/vkterm-app-launcher.c) con
# --config-default-files=false, así que ~/.config/ghostty no se lee ni se
# modifica.
#
# Dos modos por pestaña (o división):
#   - Modo terminal (tabla de atajos por defecto): un terminal como cualquier
#     otro, con las pestañas, divisiones, búsqueda y atajos de Ghostty.
#   - Modo IDE (tabla `vkterm`): el workspace tipo VS Code. `vkterm .` o
#     ⌘B / ⌘J / ⌘P / ⌘⇧P en el prompt convierten la pestaña; bin/vkterm-surface
#     activa la tabla en esa pestaña (AppleScript `perform action`) y la
#     desactiva al salir (⌘K F). Ghostty busca primero en la tabla activa y,
#     si la tecla no está, en la de por defecto: ⌘T, ⌘N, ⌘Q o ⌘+ siguen
#     funcionando en el IDE.

theme = Catppuccin Mocha
window-save-state = never
macos-titlebar-style = transparent
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

# vkTERM.app es una copia de Ghostty: se actualiza con Ghostty y
# `bin/vkterm-app install`, nunca por su cuenta.
auto-update = off

# ⌥ Option: los dos escriben los caracteres del teclado, como en cualquier
# app de macOS y en VS Code (Spanish - ISO: ⌥2 = @, ⌥3 = #, [ ] { } | \ ~).
# Las combinaciones que no producen un carácter (⌥← / ⌥→) siguen llegando
# como Alt: saltan palabra a palabra.
macos-option-as-alt = false

# ------------------------------------------------------------- modo terminal
#
# ⌘B, ⌘J, ⌘P y ⌘⇧P convierten la pestaña en el IDE de la carpeta actual y
# después hacen lo mismo que en VS Code (mostrar el explorador, el Shell,
# buscar un archivo, la paleta de comandos). Envían F13–F16 con Super, que la
# integración de zsh (config/zsh/vkterm.zsh) recoge en el prompt; fuera de él,
# los programas ignoran esas teclas.
keybind = super+b=csi:25;9~
keybind = super+j=csi:26;9~
keybind = super+p=csi:28;9~
keybind = super+shift+p=csi:29;9~

# ⌘T (pestaña nueva) y ⌘⇧, (recargar la configuración) van por tecla física
# (key_t, comma) y no por carácter. Con el carácter, Ghostty pone el atajo en
# su menú (New Tab, Reload Configuration) y macOS lo resuelve por el menú
# antes que por las tablas: en el IDE, ⌘K ⌘T abría una pestaña en vez del
# selector de tema, y ⌘⇧, recargaba sin volver a activar el modo IDE. Con la
# tecla física, el menú se queda sin atajo y el resultado es el mismo.
keybind = super+t=unbind
keybind = super+key_t=new_tab
keybind = super+shift+,=unbind
keybind = super+shift+comma=reload_config

# ----------------------------------------------------------------- modo IDE
#
# ⌘ Command: Zellij y Micro nunca reciben la tecla Command. Ghostty traduce
# estos atajos a secuencias que sí entienden:
#   - Alt+tecla (ESC + tecla): códigos internos que Zellij enlaza en
#     config/zellij/config.kdl (activos también en modo locked) y convierte en
#     mensajes al plugin vkterm.
#   - F2 (ESC O Q): Guardar en Micro. No se usa Ctrl-S porque congela la
#     salida de los comandos en los shells (control de flujo XON/XOFF).

# ⌘1..⌘5: Explorador, Editor, Claude Code, Codex, Shell (por identidad; si el
# panel está oculto, se muestra). Se cubren la tecla física (digit_N) y el
# carácter (N); en el modo terminal cambian de pestaña.
keybind = vkterm/super+digit_1=esc:1
keybind = vkterm/super+digit_2=esc:2
keybind = vkterm/super+digit_3=esc:3
keybind = vkterm/super+digit_4=esc:4
keybind = vkterm/super+digit_5=esc:5
keybind = vkterm/super+1=esc:1
keybind = vkterm/super+2=esc:2
keybind = vkterm/super+3=esc:3
keybind = vkterm/super+4=esc:4
keybind = vkterm/super+5=esc:5

# Como VS Code: ⌘B barra lateral (explorador), ⌘J panel (Shell), ⌥⌘B barra
# secundaria (Claude Code y Codex). Muestran / ocultan sin cerrar procesos.
# ⌥⌘B se cubre por tecla física y por carácter (con el ⌥ izquierdo, macOS
# convierte la b en otro carácter).
keybind = vkterm/super+b=esc:6
keybind = vkterm/super+j=esc:7
keybind = vkterm/super+alt+b=esc:8
keybind = vkterm/super+alt+key_b=esc:8

# Pestañas del editor, como VS Code: ⌘⌥← / ⌘⌥→ y ⌃⇧Tab / ⌃Tab (en el modo
# terminal son las divisiones y pestañas de Ghostty). ⌘W cierra la pestaña
# del editor; en el modo terminal cierra la de Ghostty. ⌘⌥↑ / ⌘⌥↓ mueven el
# foco al panel de arriba / abajo (editor ↔ Shell).
keybind = vkterm/super+alt+arrow_left=esc:,
keybind = vkterm/super+alt+arrow_right=esc:.
keybind = vkterm/ctrl+shift+tab=esc:,
keybind = vkterm/ctrl+tab=esc:.
keybind = vkterm/super+w=esc:9
keybind = vkterm/super+alt+arrow_up=esc:k
keybind = vkterm/super+alt+arrow_down=esc:j

# ⌘P: abrir archivo por nombre (búsqueda difusa) y ⌘⇧P: paleta de comandos,
# como VS Code. Las dos son la misma ventana flotante del plugin vkterm.
keybind = vkterm/super+p=esc:0
keybind = vkterm/super+shift+p=esc:;

# ⌘S: guardar en Micro.
keybind = vkterm/super+s=esc:OQ

# ⌘K ⌘S: ventana de atajos, como en VS Code (secuencia: ⌘K y después ⌘S).
# Ghostty espera la segunda tecla sin límite de tiempo; si no es una de las
# de abajo, envía las dos al programa. En el modo terminal ⌘K limpia la
# pantalla, como siempre.
keybind = vkterm/super+k>super+s=esc:?

# ⌘K Z: ampliar o restaurar el panel con el foco, como el modo Zen de VS Code
# (secuencia: ⌘K y después Z).
keybind = vkterm/super+k>z=esc:z

# ⌘K ⌘T: tema de color, como en VS Code (secuencia: ⌘K y después ⌘T).
keybind = vkterm/super+k>super+t=esc:t

# ⌘K F: cerrar la carpeta, como «File: Close Folder» de VS Code. Termina la
# sesión del IDE (Micro, Claude Code, Codex) y vuelve al modo terminal, con
# el shell de antes intacto.
keybind = vkterm/super+k>f=esc:q

# ⌘← / ⌘→: inicio / fin de línea (Home / End). Por defecto Ghostty envía
# Ctrl-A / Ctrl-E, que en Micro son "seleccionar todo" y "línea de comandos".
keybind = vkterm/super+arrow_left=csi:H
keybind = vkterm/super+arrow_right=csi:F

# Edición, como VS Code: ⌘Z / ⌘⇧Z deshacer / rehacer, ⌘A seleccionar todo,
# ⌘F buscar, ⌘X cortar. Llegan al plugin vkterm, que las pasa a Micro solo si
# el editor tiene el foco: en un shell, Ctrl-Z suspendería el proceso. En el
# modo terminal son las de Ghostty (deshacer, seleccionar y buscar en la
# pantalla).
keybind = vkterm/super+z=esc:u
keybind = vkterm/super+shift+z=esc:y
keybind = vkterm/super+a=esc:a
keybind = vkterm/super+f=esc:s
keybind = vkterm/super+x=esc:x

# ⌘C: copia la selección de Ghostty, como siempre, y en el editor la de Micro
# (sin selección, la línea, como VS Code). Nunca envía Ctrl-C a un shell.
keybind = vkterm/super+c=copy_to_clipboard:mixed
keybind = chain=esc:c

# ⌘V: pega el texto, como siempre (bracketed paste). En Claude Code y Codex,
# si el portapapeles solo tiene una imagen, el plugin vkterm les manda ⌃V, con
# el que la adjuntan (un terminal no puede pegar imágenes).
keybind = vkterm/super+v=paste_from_clipboard
keybind = chain=esc:v

# ⌘D / ⌘⇧D: Zellij gestiona los paneles del IDE; no se divide su pestaña. En
# el modo terminal son las divisiones de Ghostty.
keybind = vkterm/super+d=ignore
keybind = vkterm/super+shift+d=ignore

# ⌘⇧,: recargar la configuración. Ghostty vacía las tablas de atajos al
# recargar: el plugin vkterm recarga con bin/vkterm-theme, que después vuelve
# a activar el modo IDE en sus pestañas.
keybind = vkterm/super+shift+comma=esc:r

# Tipo de letra u otros ajustes propios (opcional, fuera de git), antes del
# tema.
config-file = ?../local/user.ghostty

# Tema elegido con ⌘K ⌘T (bin/vkterm-theme). Ghostty carga este archivo al
# final, así que sustituye al `theme` de arriba; "?": si no existe (no se ha
# elegido ninguno), se queda Catppuccin Mocha.
config-file = ?../local/theme.ghostty
