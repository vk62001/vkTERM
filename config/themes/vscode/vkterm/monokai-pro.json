{
  // Monokai Pro es un tema de pago y su archivo no se puede copiar. Este es de
  // vkTERM: usa solo la paleta de terminal "Monokai Pro" que trae Ghostty
  // (fondo #2d2a2e, texto #fcfcfa, cursor, selección y los seis acentos), con
  // el reparto de colores habitual del tema. Los grises de la interfaz son
  // mezclas del fondo y el texto. Es una aproximación, no el tema original.
  "name": "Monokai Pro (aproximación de vkTERM)",
  "type": "dark",
  "colors": {
    "editor.background": "#2d2a2e",
    "editor.foreground": "#fcfcfa",
    "editorCursor.foreground": "#c1c0c0",
    "editor.selectionBackground": "#5b595c",
    "editor.lineHighlightBackground": "#39363a",
    "editorLineNumber.foreground": "#5b595c",
    "editorLineNumber.activeForeground": "#c1c0c0",
    "editorIndentGuide.background1": "#423f42",
    "editorBracketMatch.background": "#5b595c",
    "editorBracketMatch.border": "#8e8d8d",
    "editorGroup.border": "#191719",
    "editorGroupHeader.tabsBackground": "#222023",
    "tab.activeBackground": "#2d2a2e",
    "tab.activeForeground": "#ffd866",
    "tab.inactiveBackground": "#222023",
    "tab.inactiveForeground": "#8e8d8d",
    "sideBar.background": "#222023",
    "sideBar.foreground": "#c1c0c0",
    "sideBarSectionHeader.background": "#222023",
    "sideBarSectionHeader.foreground": "#8e8d8d",
    "list.activeSelectionBackground": "#5b595c",
    "list.activeSelectionForeground": "#ffd866",
    "list.inactiveSelectionBackground": "#423f42",
    "list.inactiveSelectionForeground": "#fcfcfa",
    "list.highlightForeground": "#ffd866",
    "focusBorder": "#727072",
    "descriptionForeground": "#8e8d8d",
    "quickInput.background": "#222023",
    "quickInput.foreground": "#c1c0c0",
    "keybindingLabel.foreground": "#78dce8",
    "pickerGroup.foreground": "#ab9df2",
    "statusBar.background": "#222023",
    "statusBar.foreground": "#8e8d8d",
    "statusBarItem.remoteBackground": "#ffd866",
    "statusBarItem.remoteForeground": "#2d2a2e",
    "terminal.ansiBlack": "#2d2a2e",
    "terminal.ansiRed": "#ff6188",
    "terminal.ansiGreen": "#a9dc76",
    "terminal.ansiYellow": "#ffd866",
    "terminal.ansiBlue": "#fc9867",
    "terminal.ansiMagenta": "#ab9df2",
    "terminal.ansiCyan": "#78dce8",
    "terminal.ansiWhite": "#fcfcfa",
    "terminal.ansiBrightBlack": "#727072",
    "terminal.ansiBrightRed": "#ff6188",
    "terminal.ansiBrightGreen": "#a9dc76",
    "terminal.ansiBrightYellow": "#ffd866",
    "terminal.ansiBrightBlue": "#fc9867",
    "terminal.ansiBrightMagenta": "#ab9df2",
    "terminal.ansiBrightCyan": "#78dce8",
    "terminal.ansiBrightWhite": "#fcfcfa",
    "terminalCursor.foreground": "#c1c0c0"
  },
  "tokenColors": [
    {"scope": "comment", "settings": {"foreground": "#727072", "fontStyle": "italic"}},
    {"scope": ["string", "markup.underline.link"], "settings": {"foreground": "#ffd866"}},
    {"scope": ["constant", "constant.numeric", "constant.language", "constant.character"], "settings": {"foreground": "#ab9df2"}},
    {"scope": ["keyword", "storage", "keyword.operator", "keyword.control", "entity.name.tag"], "settings": {"foreground": "#ff6188"}},
    {"scope": ["entity.name.function", "support.function"], "settings": {"foreground": "#a9dc76"}},
    {"scope": ["entity.name.type", "support.type", "support.class", "storage.type", "entity.other.attribute-name"], "settings": {"foreground": "#78dce8"}},
    {"scope": ["variable.parameter", "constant.character.escape"], "settings": {"foreground": "#fc9867"}},
    {"scope": "punctuation", "settings": {"foreground": "#8e8d8d"}},
    {"scope": "invalid", "settings": {"foreground": "#ff6188", "fontStyle": "underline"}}
  ]
}
