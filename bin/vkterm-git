#!/bin/zsh
# vkTERM — git para la vista «Control de código fuente» del plugin vkterm
# (⌃⇧G), como la vista "Source Control" de VS Code, y para los colores de git
# del explorador.
#
#   vkterm-git status [RAMA] [CLAVE]   estado del repositorio (abajo)
#   vkterm-git branches                ramas para comparar: local<TAB>main,
#                                      remote<TAB>origin/main
#   vkterm-git stage RUTA…             preparar (también borrados y nuevos)
#   vkterm-git unstage RUTA…           quitar de lo preparado
#   vkterm-git stage-all | unstage-all
#   vkterm-git discard RUTA…           descartar los cambios sin preparar
#   vkterm-git clean RUTA…             borrar archivos nuevos (sin seguimiento)
#   vkterm-git commit [--all] MENSAJE  --all: prepara todo antes
#   vkterm-git abort                   abortar la fusión (o rebase, cherry-pick,
#                                      revert) en curso
#   vkterm-git diff MODO RUTA [ORIGEN] diferencias con el paginador de git, en
#                                      una ventana flotante. MODO: staged,
#                                      changes, untracked, merge o el árbol de
#                                      `status` (tree=) para los conflictos
#                                      que habría al fusionar
#   vkterm-git remote pull|push|sync|fetch
#                                      en una ventana flotante: se ve la salida
#                                      y se pueden escribir credenciales
#   vkterm-git show TEXTO              un texto en el paginador (la salida de un
#                                      commit que falló)
#
# Las rutas son relativas a la raíz del repositorio y se ejecuta desde ella.
#
# `status` escribe registros separados por NUL: primero clave=valor, después
# uno "--" y detrás la salida de `git status --porcelain=v2 -z --branch`
# (src/git.rs la interpreta):
#   repo=0                  no hay repositorio (no escribe nada más)
#   root= prefix=           raíz y carpeta del proyecto dentro de ella
#   operation=              merge, rebase, cherry-pick o revert en curso
#   merge_msg=              primera línea del mensaje que propone git
#   target=                 rama con la que se comparan los conflictos: RAMA
#                           o, si no se da, la principal (main, master…)
#   check=HEAD:RAMA         commits comparados; si coincide con CLAVE no se
#                           vuelve a calcular y merge=same
#   merge=                  none, same, clean, conflicts, unrelated, missing,
#                           unsupported (git < 2.38) o error
#   tree= conflict=…        el resultado con marcas de conflicto (para `diff`)
#                           y los archivos que chocarían
#   ahead= behind=          commits de HEAD que no tiene RAMA y al revés
emulate -L zsh
setopt no_unset pipe_fail

# Las rutas son nombres, no patrones.
export GIT_LITERAL_PATHSPECS=1

record() { print -rn -- "$1"$'\0' }

has_head() { git rev-parse -q --verify HEAD >/dev/null }

# La rama principal: la de origin/HEAD, main o master (local si existe).
default_target() {
  local remote_head candidate
  remote_head=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || remote_head=
  for candidate in ${remote_head#origin/} main master; do
    [[ -n $candidate ]] || continue
    if git show-ref -q --verify refs/heads/$candidate; then
      print -r -- $candidate
      return
    fi
  done
  [[ -z $remote_head ]] || print -r -- $remote_head
}

# Conflictos que habría al fusionar $target en HEAD, sin tocar nada
# (git merge-tree --write-tree, git 2.38+).
merge_check() {
  local target=$1 last=$2 head theirs out code
  record target=$target
  head=$(git rev-parse -q --verify HEAD) || { record merge=none; return }
  if [[ -z $target ]] || [[ $(git symbolic-ref -q --short HEAD 2>/dev/null) == $target ]]; then
    record merge=none
    return
  fi
  theirs=$(git rev-parse -q --verify "$target^{commit}") || { record merge=missing; return }
  record check=$head:$theirs
  if [[ $head:$theirs == $last ]]; then
    record merge=same
    return
  fi
  local counts=(${=$(git rev-list --left-right --count $head...$theirs 2>/dev/null)})
  if (( $#counts == 2 )); then
    record ahead=$counts[1]
    record behind=$counts[2]
  fi
  # Con los nombres (no los commits): son las etiquetas de las marcas.
  out=$(git merge-tree --write-tree --name-only -z --no-messages HEAD $target 2>/dev/null)
  code=$?
  case $code in
    0) record merge=clean ;;
    1)
      local files=(${(0)out})
      record merge=conflicts
      record tree=$files[1]
      for file in ${(u)files[2,-1]}; do
        record conflict=$file
      done
      ;;
    129) record merge=unsupported ;;
    *)
      if git merge-base $head $theirs >/dev/null 2>&1; then
        record merge=error
      else
        record merge=unrelated
      fi
      ;;
  esac
}

operation() {
  local dir=$1
  if [[ -f $dir/MERGE_HEAD ]]; then
    print merge
  elif [[ -d $dir/rebase-merge || -d $dir/rebase-apply ]]; then
    print rebase
  elif [[ -f $dir/CHERRY_PICK_HEAD ]]; then
    print cherry-pick
  elif [[ -f $dir/REVERT_HEAD ]]; then
    print revert
  fi
}

status() {
  local info
  info=$(git rev-parse --show-toplevel --show-prefix --absolute-git-dir 2>/dev/null) || {
    record repo=0
    return 0
  }
  local lines=("${(@f)info}")
  # --show-prefix escribe una línea vacía en la raíz.
  (( $#lines == 3 )) || lines=($lines[1] "" $lines[-1])
  local gitdir=$lines[3] op
  op=$(operation $gitdir)
  record repo=1
  record root=$lines[1]
  record prefix=$lines[2]
  record operation=$op
  if [[ -n $op && -f $gitdir/MERGE_MSG ]]; then
    record "merge_msg=$(head -n 1 $gitdir/MERGE_MSG)"
  fi
  local target=${1:-}
  [[ -n $target ]] || target=$(default_target)
  merge_check "$target" "${2:-}"
  record --
  # Sin bloqueos opcionales: `status` no reescribe el índice, que el plugin
  # vigila (si no, cada lectura provocaría otra).
  git --no-optional-locks status --porcelain=v2 -z --branch --untracked-files=all --ignored=matching
}

# El paginador de git, sin salir solo si el texto cabe en la pantalla: la
# ventana se cierra cuando termina. Si el paginador no es less (delta, cat…),
# se espera una tecla.
pager_setup() {
  export LESS="${LESS:--R} -+F"
  local pager
  pager=$(git var GIT_PAGER 2>/dev/null) || pager=less
  [[ $pager == less || $pager == less\ * ]]
}

wait_key() {
  print -n -- "\n$1 Pulsa una tecla para cerrar."
  read -s -k 1
}

diff_file() {
  local mode=$1 file=$2 orig=${3:-}
  local options=() paths=(-- $file)
  [[ -z $orig ]] || paths=(-- $orig $file)
  case $mode in
    staged) options=(--cached -M) ;;
    changes|merge) ;;
    untracked) options=(--no-index); paths=(-- /dev/null $file) ;;
    *) options=(HEAD $mode) ;;  # el árbol de `status`: lo que chocaría
  esac
  local less=0
  pager_setup && less=1
  if git diff $options --quiet $paths >/dev/null 2>&1; then
    print -r -- "Sin diferencias de texto en $file (binario o solo permisos)."
    wait_key ""
    return 0
  fi
  git diff $options $paths
  (( less )) || wait_key ""
  return 0
}

remote() {
  local action=$1 code=0
  case $action in
    pull) print -r -- "› git pull"; git pull; code=$? ;;
    fetch) print -r -- "› git fetch --prune"; git fetch --prune; code=$? ;;
    push|sync)
      if [[ $action == sync ]]; then
        print -r -- "› git pull"
        git pull || code=$?
        print
      fi
      if (( code == 0 )); then
        if git rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
          print -r -- "› git push"
          git push; code=$?
        else
          # Como «Publicar rama» de VS Code: con el único remoto que haya.
          local remotes=(${(f)"$(git remote)"})
          if (( $#remotes == 1 )); then
            print -r -- "› git push -u $remotes[1] HEAD"
            git push -u $remotes[1] HEAD; code=$?
          else
            print -r -- "La rama no tiene upstream y no hay un único remoto: usa git push -u REMOTO RAMA en el Shell."
            code=1
          fi
        fi
      fi
      ;;
    *) print -u2 "uso: vkterm-git remote pull|push|sync|fetch"; return 2 ;;
  esac
  if (( code == 0 )); then
    wait_key "Listo."
  else
    wait_key "Falló (código $code)."
  fi
  return $code
}

case ${1:-} in
  status)
    status "${2:-}" "${3:-}"
    ;;
  branches)
    git for-each-ref --format='%(refname)' refs/heads refs/remotes | while read -r ref; do
      case $ref in
        refs/heads/*) print -r -- "local	${ref#refs/heads/}" ;;
        refs/remotes/*/HEAD) ;;
        refs/remotes/*) print -r -- "remote	${ref#refs/remotes/}" ;;
      esac
    done
    ;;
  stage)
    shift
    git add -A -- "$@"
    ;;
  unstage)
    shift
    if has_head; then
      git restore --staged -- "$@"
    else
      git rm --cached -r -q -- "$@"
    fi
    ;;
  stage-all)
    GIT_LITERAL_PATHSPECS=0 git add -A :/
    ;;
  unstage-all)
    if has_head; then
      git reset -q
    else
      GIT_LITERAL_PATHSPECS=0 git rm --cached -r -q :/
    fi
    ;;
  discard)
    shift
    git restore --worktree -- "$@"
    ;;
  clean)
    shift
    git clean -f -q -- "$@"
    ;;
  commit)
    shift
    if [[ ${1:-} == --all ]]; then
      shift
      GIT_LITERAL_PATHSPECS=0 git add -A :/ || exit
    fi
    (( $# == 1 )) && [[ -n $1 ]] || { print -u2 "uso: vkterm-git commit [--all] MENSAJE"; exit 2; }
    git commit -q -m "$1" && git log -1 --format='%h %s'
    ;;
  abort)
    dir=$(git rev-parse --absolute-git-dir) || exit
    case $(operation $dir) in
      merge) git merge --abort ;;
      rebase) git rebase --abort ;;
      cherry-pick) git cherry-pick --abort ;;
      revert) git revert --abort ;;
      *) print -u2 "No hay ninguna fusión en curso."; exit 1 ;;
    esac
    ;;
  diff)
    (( $# >= 3 )) || { print -u2 "uso: vkterm-git diff MODO RUTA [ORIGEN]"; exit 2; }
    diff_file "$2" "$3" "${4:-}"
    ;;
  remote)
    remote "${2:-}"
    ;;
  show)
    print -r -- "${2:-}" | less -R -+F
    ;;
  *)
    print -u2 "uso: vkterm-git status|branches|stage|unstage|stage-all|unstage-all|discard|clean|commit|abort|diff|remote|show"
    exit 2
    ;;
esac
