#!/bin/zsh
# vkTERM — tema de color guardado y su aplicación en vivo (⌘K ⌘T).
#
#   vkterm-theme current          id del tema guardado (vacío: el predeterminado)
#   vkterm-theme set ID           lo guarda y cambia Ghostty (Micro lo sigue solo)
#   vkterm-theme value CLAVE      zellij o micro: el nombre del tema guardado
#   vkterm-theme reload           Ghostty relee la configuración (⌘⇧, en el IDE)
#   vkterm-theme sync             theme.ghostty con el tema guardado (al abrir el IDE)
#   vkterm-theme terminal PID     el Ghostty que dibuja el terminal de PID (o nada)
#
# Cada tema (config/themes/themes.json) tiene, con el nombre vkterm-<id>, un
# tema de Ghostty, uno de Zellij y un esquema de Micro (scripts/gen-themes.py).
# Lo usa el plugin vkterm; el tema de Zellij lo cambia el propio plugin y el
# de Micro, el plugin Lua de Micro (config/micro/plugins/vkterm), que vigila
# el archivo `theme`. El estado vive en config/local (o VKTERM_STATE_DIR),
# fuera de git:
#   theme           id del tema elegido
#   theme.ghostty   lo incluye config/ghostty/vkterm.ghostty
emulate -L zsh
setopt no_unset pipe_fail

vkterm_home=${0:A:h:h}
state=${VKTERM_STATE_DIR:-$vkterm_home/config/local}

saved_id() {
  [[ -f $state/theme ]] || return 0
  sed -n 's/^id=//p' $state/theme
}

# Nombre del tema de Zellij y del esquema de Micro: el del guardado, si
# existe; si no (o no hay ninguno guardado), el predeterminado.
value() {
  local id=$(saved_id)
  if [[ -z $id || ! -f $vkterm_home/config/micro/colorschemes/vkterm-$id.micro ]]; then
    id=$(sed -n 's/^ *"default": *"\([^"]*\)".*/\1/p' $vkterm_home/config/themes/themes.json)
  fi
  print -r -- "vkterm-$id"
}

# Ghostty que dibuja el terminal del proceso $1: el padre del primero de los
# procesos de ese terminal (mismo tty), si es Ghostty. Sin el límite del tty,
# un cliente en el pseudoterminal de otro programa (scripts/smoke-test.py
# ejecutado desde una pestaña de vkTERM.app) llegaba hasta el Ghostty de esa
# pestaña y lo recargaba: las pestañas del IDE del usuario perdían los
# atajos ⌘.
terminal_of() {
  local pid=$1 tty comm
  tty=$(ps -o tty= -p $pid 2>/dev/null | tr -d ' ')
  [[ -n $tty ]] || return 0
  while (( pid > 1 )); do
    pid=$(ps -o ppid= -p $pid 2>/dev/null | tr -d ' ')
    [[ -n $pid ]] || return 0
    comm=$(ps -o comm= -p $pid 2>/dev/null) || return 0
    if [[ ${comm:t} == ghostty ]]; then
      print $pid
      return 0
    fi
    [[ $(ps -o tty= -p $pid | tr -d ' ') == $tty ]] || return 0
  done
}

# Ghostty que muestra esta sesión: el de sus clientes de Zellij (o, sin
# sesión, el de este proceso: ⌘+ en el prompt del modo terminal,
# bin/vkterm-font). SIGUSR2 le hace releer la configuración: todas sus
# ventanas cambian de tema.
#
# Al recargar, Ghostty vacía las tablas de atajos: las pestañas en modo IDE
# volverían al modo terminal. bin/vkterm-surface les devuelve la suya cuando
# la recarga ha terminado (dos intentos; activar una tabla ya activa no hace
# nada). Sin segundo plano: Zellij termina los procesos que deja un comando
# del plugin, y el plugin no espera este resultado.
reload_ghostty() {
  local pid ghostty reloaded=0 starts=($$)
  if [[ -n ${ZELLIJ_SESSION_NAME:-} ]]; then
    starts=($(pgrep -f -- "zellij .*(--session|attach) $ZELLIJ_SESSION_NAME( |\$)"))
  fi
  for pid in $starts; do
    ghostty=$(terminal_of $pid)
    if [[ -n $ghostty ]]; then
      kill -USR2 $ghostty
      reloaded=1
    fi
  done
  if (( reloaded )); then
    sleep 0.8
    vkterm-surface reactivate
    sleep 1.2
    vkterm-surface reactivate
  fi
}

case ${1:-} in
  current)
    saved_id
    ;;
  value)
    [[ ${2:-} == (zellij|micro) ]] || { print -u2 "uso: vkterm-theme value zellij|micro"; exit 2; }
    value
    ;;
  reload)
    reload_ghostty
    ;;
  terminal)
    terminal_of ${2:?uso: vkterm-theme terminal PID}
    ;;
  sync)
    # Antes de 0.3.0, theme.ghostty tenía el nombre de un tema de Ghostty;
    # ahora apunta al de vkTERM del tema guardado. Ghostty lo lee al recargar
    # o al abrir la app.
    id=$(saved_id)
    ghostty=$vkterm_home/config/ghostty/themes/vkterm-$id
    [[ -n $id && -f $ghostty ]] || exit 0
    line="theme = $ghostty"
    if [[ ! -f $state/theme.ghostty || $(<$state/theme.ghostty) != $line ]]; then
      print -r -- $line > $state/theme.ghostty
    fi
    ;;
  set)
    # Las sesiones de antes de 0.3.0 mandan también GHOSTTY ZELLIJ MICRO: se
    # ignoran, los nombres salen del id.
    id=${2:?uso: vkterm-theme set ID}
    ghostty=$vkterm_home/config/ghostty/themes/vkterm-$id
    [[ -f $ghostty ]] || { print -u2 "vkterm-theme: no existe el tema $id"; exit 1; }
    mkdir -p $state
    # Atómico: el plugin de Micro lo lee mientras tanto.
    print -r -- "id=$id" > $state/theme.tmp && mv $state/theme.tmp $state/theme
    print -r -- "theme = $ghostty" > $state/theme.ghostty
    reload_ghostty
    ;;
  *)
    print -u2 "uso: vkterm-theme current | set ID | value zellij|micro | reload | sync | terminal PID"
    exit 2
    ;;
esac
