#!/bin/zsh
# vkTERM — el comando `vkterm`, como `code` de VS Code: abre una carpeta en el
# IDE (explorador, editor con pestañas, Shell, Claude Code y Codex).
#
#   vkterm [--then ACCIÓN] [--here] [--new] [DIRECTORIO] [ARCHIVO]
#   vkterm --version
#
#   DIRECTORIO  carpeta del proyecto; por defecto, la actual.
#   ARCHIVO     archivo que se abre en el editor (relativo al proyecto). Si se
#               omite, las pestañas de la última vez o la línea `open=` del
#               archivo .vkterm del proyecto.
#
# Dónde se abre:
#   - En una pestaña de vkTERM.app en modo terminal: esa misma pestaña pasa a
#     ser el IDE. El shell queda debajo, intacto; al cerrar la carpeta (⌘K F)
#     se vuelve a él.
#   - Desde otro terminal o desde el Shell del propio IDE: en una ventana
#     nueva de vkTERM.app (bin/vkterm-surface open).
#   - Si la carpeta ya está abierta en otra pestaña, se enfoca esa pestaña.
#
#   --here      el IDE en el terminal actual, sea cual sea, sin modos ni atajos
#               ⌘ de vkTERM.app (otros emuladores y scripts/smoke-test.py).
#   --then      acción al abrir, como los atajos del modo terminal:
#               show_sidebar (⌘B), show_panel (⌘J), quick_open (⌘P) o
#               command_palette (⌘⇧P).
#   --new       siempre una sesión nueva, aunque la carpeta ya esté abierta.
#   --version   la versión de vkTERM (archivo VERSION; cambios en CHANGELOG.md).
emulate -L zsh
setopt err_exit no_unset pipe_fail

vkterm_home=${0:A:h:h}
bin=$vkterm_home/bin
here=0 new=0 then=
while (( $# )); do
  case $1 in
    --here) here=1 ;;
    --new) new=1 ;;
    --version) print -r -- "vkTERM $(<$vkterm_home/VERSION)"; exit 0 ;;
    --then) then=${2:?falta la acción de --then}; shift ;;
    --) shift; break ;;
    -*) print -u2 "vkterm: opción desconocida: $1"; exit 2 ;;
    *) break ;;
  esac
  shift
done
project=${1:-$PWD}
file=${2:-}
if [[ ! -d $project ]]; then
  print -u2 "vkterm: no existe el directorio: $project"
  exit 1
fi
project=${project:A}
export VKTERM_THEN=$then

if (( here )); then
  exec $bin/vkterm-workspace ${${new:#0}:+--new} $project ${file:+"$file"}
fi

memory=$($bin/vkterm-state dir $project)
surface=$memory/surface

# Como VS Code: si la carpeta ya está abierta, se va a su pestaña. Si la
# pestaña ya no existe (se cerró la ventana sin que bin/vkterm pudiera borrar
# el archivo), se abre de nuevo.
if (( ! new )) && [[ -f $surface ]]; then
  pid=$(sed -n 's/^pid=//p' $surface) id=$(sed -n 's/^id=//p' $surface)
  if [[ -n $pid && -n $id ]] && kill -0 $pid 2>/dev/null \
      && VKTERM_APP_ID=$(sed -n 's/^app=//p' $surface) $bin/vkterm-surface focus $id; then
    exit 0
  fi
  rm -f $surface
fi

# Fuera de una pestaña de vkTERM.app en modo terminal: ventana nueva.
open_window() {
  if [[ -z ${VKTERM_APP_ID:-} && ! -d $($bin/vkterm-app path) ]]; then
    print -u2 "vkterm: falta vkTERM.app; créala con: $bin/vkterm-app install"
    print -u2 "        (o abre el IDE en este terminal con: vkterm --here ${(q)project})"
    exit 1
  fi
  [[ -z $file ]] || print -u2 "vkterm: la ventana nueva abre la carpeta; el archivo se omite."
  $bin/vkterm-surface open $project $then
  exit 0
}
if [[ -n ${ZELLIJ:-} || -z ${VKTERM_APP_ID:-} || ${TERM_PROGRAM:-} != ghostty ]]; then
  open_window
fi

# En el sitio. Un título único (OSC 2) identifica esta pestaña ante AppleScript;
# si no se encuentra (p. ej. dentro de tmux), ventana nueva.
nonce=vkterm-$$-$RANDOM$RANDOM
print -n "\e]2;$nonce\a" > /dev/tty
if ! id=$($bin/vkterm-surface claim $nonce) || [[ -z $id ]]; then
  open_window
fi
print -l "id=$id" "pid=$$" "app=$VKTERM_APP_ID" > $surface

restore() {
  rm -f $surface
  $bin/vkterm-surface release $id || true
  # Como al salir de vim: el cursor vuelve a donde estaba y se borra lo que
  # Zellij deja debajo ("Bye from Zellij!"). Y la carpeta del shell para
  # Ghostty (⌘T abre ahí la pestaña nueva).
  print -n "\e8\e[J\e]7;file://${HOST}${PWD}\a" > /dev/tty 2>/dev/null || true
}
# Al cerrar la pestaña (SIGHUP) ya no hay terminal que restaurar.
trap 'rm -f $surface; exit 129' HUP
# ⌘T durante el IDE abre la pestaña nueva en la carpeta del proyecto. \e7
# guarda la posición del cursor para restore().
print -n "\e7\e]7;file://${HOST}${project}\a" > /dev/tty
code=0
$bin/vkterm-workspace ${${new:#0}:+--new} $project ${file:+"$file"} || code=$?
restore
exit $code
