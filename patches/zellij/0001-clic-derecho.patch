+    fn execute_right_click(
+        tab: &mut Tab,
+        pane_id: PaneId,
+        event: MouseEvent,
+        client_id: ClientId,
+    ) -> Result<MouseEffect> {
+        let err_context = || format!("failed to right click pane {pane_id:?}");
+        let focus_changed = tab.get_active_pane_id(client_id) != Some(pane_id);
+        if focus_changed {
+            clear_hover_for_client(tab, client_id);
+            Self::focus_pane_at(tab, &event.position, client_id).with_context(err_context)?;
+        }
+        if matches!(pane_id, PaneId::Plugin(_)) {
+            if let Some(pane) = tab.get_pane_with_id_mut(pane_id) {
+                if !pane.position_is_on_frame(&event.position) {
+                    let relative_position = pane.relative_position(&event.position);
+                    pane.handle_right_click(&relative_position, client_id);
+                }
+            }
+        } else {
+            Self::execute_send_to_terminal(tab, pane_id, event, client_id)
+                .with_context(err_context)?;
+        }
+        Ok(if focus_changed {
+            MouseEffect::state_changed()
+        } else {
+            MouseEffect::default()
+        })
+    }
